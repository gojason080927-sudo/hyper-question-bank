# Copy to .env.local for local development.
# Do not put real secrets in this file.
# Frontend may use only the public URL + anon key.
# Question-bank project only (ref owp…). Never Student Care.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server / acceptance tests only. Never prefix with VITE_. Never commit real values.
# Never expose service-role to the browser. Cloud Agents must not invent this key.
# Prefer signed URLs (staff session) over service role for Storage reads.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_PASSWORD=

# Local OCR worker / STEP 7.5–7.6 benchmark only. Never prefix with VITE_.
# Never put these in browser JavaScript, git, or chat.
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
MISTRAL_API_KEY=
